#!/bin/bash -ex

DB_NAME=suitecrm
DB_USER=suitecrm
DB_PASS=$(mcookie)
ADMIN_NAME=admin
ADMIN_PASS=turnkey
SRC=/usr/local/src
WEBROOT=/var/www/suitecrm
CONF_FILE=/etc/apache2/sites-available/suitecrm.conf

# 1. Update Apache DocumentRoot & Directory to /public
if [ -f "$CONF_FILE" ]; then
    if grep -qE "DocumentRoot[[:space:]]+$WEBROOT$" "$CONF_FILE"; then
        sed -i "s|DocumentRoot $WEBROOT$|DocumentRoot $WEBROOT/public|g" "$CONF_FILE"
    fi
    if grep -q "<Directory $WEBROOT/>" "$CONF_FILE"; then
        sed -i "s|<Directory $WEBROOT/>|<Directory $WEBROOT/public/>|g" "$CONF_FILE"
    fi
fi

# 2. Extract & Permissions
mkdir -p "$WEBROOT"
unzip "$SRC"/suitecrm-*.zip -d "$WEBROOT"
rm -f "$SRC"/suitecrm-*.zip

find "$WEBROOT" -type d -exec chmod 2755 {} \;
find "$WEBROOT" -type f -exec chmod 0644 {} \;
chown -R www-data:www-data "$WEBROOT"
chmod +x "$WEBROOT/bin/console"

# 3. PHP & DB Setup
PHP_VER=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')
PHPINI="/etc/php/$PHP_VER/apache2/php.ini"
sed -i "s|^variables_order.*|variables_order = \"EGPCS\"|" "$PHPINI"
sed -i "s|^memory_limit.*|memory_limit = 512M|" "$PHPINI"

service mysql start
mysql --user=root -e "CREATE DATABASE $DB_NAME; GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';"

# 4. Install (No --unattended)
cd "$WEBROOT"
./bin/console suitecrm:app:install \
    -u "$ADMIN_NAME" \
    -p "$ADMIN_PASS" \
    -U "$DB_USER" \
    -P "$DB_PASS" \
    -H "127.0.0.1" \
    -N "$DB_NAME" \
    -S "http://localhost" \
    -d "no"

# 5. Fix Legacy Path
sed -i 's|RewriteBase .*|RewriteBase /legacy/|' "$WEBROOT/public/legacy/.htaccess"
chown -R www-data:www-data "$WEBROOT"

service apache2 stop
service mysql stop